<!doctype html>

<html lang="en">
<head>

<meta charset="utf-8">

<meta name="viewport"
      content="width=device-width,initial-scale=1">

<title>Minecraft Skin Walking GIF</title>

<style>

html, body {

    margin: 0;

    width: 100%;

    height: 100%;

    overflow: hidden;

    background: #ffffff;
}


body {

    display: flex;

    align-items: center;

    justify-content: center;
}


canvas {

    display: block;

    background: transparent;
}

</style>

</head>


<body>

<canvas
    id="skinCanvas"
    width="345"
    height="460">
</canvas>


<script src="https://cdn.jsdelivr.net/npm/skinview3d@3.4.2/bundles/skinview3d.bundle.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/gif.js/0.2.0/gif.js"></script>


<script>

(function () {

    "use strict";


    // ==========================================
    // CANVAS
    // ==========================================

    const canvas =
        document.getElementById("skinCanvas");


    // ==========================================
    // MINECRAFT SKIN
    // ==========================================

    const skin =
        "data:image/png;base64,";


    // ==========================================
    // VIEWER
    // ==========================================

    const viewer =
        new skinview3d.SkinViewer({

            canvas: canvas,

            width: 600,

            height: 1000,

            skin: skin,

            preserveDrawingBuffer: true

        });


    // ==========================================
    // TRANSPARENT BACKGROUND
    // ==========================================

    viewer.background = null;


    if (
        viewer.renderer &&
        typeof viewer.renderer.setClearColor === "function"
    ) {

        viewer.renderer.setClearColor(
            0x000000,
            0
        );

    }


    if (
        viewer.renderer &&
        typeof viewer.renderer.setClearAlpha === "function"
    ) {

        viewer.renderer.setClearAlpha(0);

    }


    // ==========================================
    // CONTROLS
    // ==========================================

    viewer.autoRotate = false;


    viewer.controls.enableRotate = false;

    viewer.controls.enableZoom = false;

    viewer.controls.enablePan = false;


    // ==========================================
    // CAMERA
    // ==========================================

    viewer.zoom = 0.85;

    viewer.fov = 70;

    viewer.camera.position.y = 7.5;


    // ==========================================
    // WALKING ANIMATION
    // ==========================================

    const walking =
        new skinview3d.WalkingAnimation();


    walking.speed = 0.8;

    walking.headBobbing = false;


    viewer.animation = walking;


    // ==========================================
    // LIGHTING
    // ==========================================

    viewer.globalLight.intensity = 3;

    viewer.cameraLight.intensity = 0.6;


    // ==========================================
    // RESIZE
    // ==========================================

    function resize() {

        const w =
            Math.min(
                window.innerWidth * 0.9,
                345
            );


        const h =
            Math.min(
                window.innerHeight * 0.9,
                460
            );


        viewer.width =
            Math.max(
                160,
                Math.floor(w)
            );


        viewer.height =
            Math.max(
                220,
                Math.floor(h)
            );

    }


    window.addEventListener(
        "resize",
        resize
    );


    resize();


    // ==========================================
    // GIF SETTINGS
    // ==========================================
    //
    // FRAMES:
    // Number of ACTUAL frames captured.
    //
    // DURATION:
    // Total playback time of the GIF in seconds.
    //
    // FRAME_DELAY:
    // Automatically calculated from the above.
    //
    // Example:
    //
    // 60 frames
    // 5 seconds
    //
    // = 83.33ms per frame
    //
    // The GIF format stores frame delays in
    // centiseconds, so GIF.js effectively rounds
    // this to the nearest ~10ms.
    //
    // ==========================================

    const FRAMES = 140;

    const DURATION = 2;


    // Automatically calculate delay.
    const FRAME_DELAY =
        (DURATION * 1000) / FRAMES;


    // Number of frames to capture.
    const TOTAL_FRAMES = FRAMES;


    console.log(
        "GIF settings:"
    );


    console.log(
        "Frames:",
        FRAMES
    );


    console.log(
        "Duration:",
        DURATION,
        "seconds"
    );


    console.log(
        "Calculated frame delay:",
        FRAME_DELAY,
        "ms"
    );


    const WORKER_URL =
        "https://cdnjs.cloudflare.com/ajax/libs/gif.js/0.2.0/gif.worker.js";


    // ==========================================
    // GIF CAMERA
    //
    // These move the PLAYER inside the GIF.
    //
    // They do NOT rotate the Minecraft player.
    //
    // Positive X = right
    // Negative X = left
    //
    // Positive Y = down
    // Negative Y = up
    //
    // ==========================================

    const GIF_CAMERA_X = -43.125;

    const GIF_CAMERA_Y = -43.125;


    // ==========================================
    // ALPHA THRESHOLD
    //
    // GIF transparency is binary.
    //
    // Pixels below this alpha value become
    // completely transparent.
    //
    // Pixels at or above this value remain
    // completely visible.
    //
    // ==========================================

    const ALPHA_THRESHOLD = 128;


    // ==========================================
    // GIF WORKER
    // ==========================================

    async function createWorkerURL() {

        console.log(
            "Loading GIF encoder worker..."
        );


        const response =
            await fetch(WORKER_URL);


        if (!response.ok) {

            throw new Error(
                "Could not load GIF worker: HTTP " +
                response.status
            );

        }


        const workerCode =
            await response.text();


        const workerBlob =
            new Blob(
                [workerCode],
                {
                    type:
                        "application/javascript"
                }
            );


        return URL.createObjectURL(
            workerBlob
        );

    }


    // ==========================================
    // CAPTURE FRAME
    // ==========================================

    function captureCanvasImage() {

        return new Promise(
            function (resolve, reject) {

                try {

                    // ==================================
                    // RENDER CURRENT VIEW
                    // ==================================

                    if (
                        typeof viewer.render ===
                        "function"
                    ) {

                        viewer.render();

                    }


                    // ==================================
                    // GET CANVAS IMAGE
                    // ==================================

                    const dataURL =
                        canvas.toDataURL(
                            "image/png"
                        );


                    const image =
                        new Image();


                    image.onload =
                        function () {

                            // ==================================
                            // GIF CAMERA CANVAS
                            // ==================================

                            const gifCamera =
                                document.createElement(
                                    "canvas"
                                );


                            gifCamera.width =
                                345;


                            gifCamera.height =
                                460;


                            const ctx =
                                gifCamera.getContext(
                                    "2d",
                                    {
                                        alpha: true
                                    }
                                );


                            // ==================================
                            // COMPLETELY TRANSPARENT CANVAS
                            // ==================================

                            ctx.clearRect(
                                0,
                                0,
                                345,
                                460
                            );


                            // ==================================
                            // MOVE CAPTURED PLAYER
                            // ==================================

                            ctx.drawImage(
                                image,

                                GIF_CAMERA_X,

                                GIF_CAMERA_Y
                            );


                            // ==================================
                            // PROCESS ALPHA
                            // ==================================

                            const imageData =
                                ctx.getImageData(
                                    0,
                                    0,
                                    345,
                                    460
                                );


                            const pixels =
                                imageData.data;


                            for (
                                let i = 0;
                                i < pixels.length;
                                i += 4
                            ) {

                                const alpha =
                                    pixels[i + 3];


                                if (
                                    alpha <
                                    ALPHA_THRESHOLD
                                ) {

                                    // Fully transparent
                                    pixels[i] = 0;

                                    pixels[i + 1] = 0;

                                    pixels[i + 2] = 0;

                                    pixels[i + 3] = 0;

                                } else {

                                    // Fully opaque
                                    pixels[i + 3] = 255;

                                }

                            }


                            ctx.putImageData(
                                imageData,
                                0,
                                0
                            );


                            resolve(
                                gifCamera
                            );

                        };


                    image.onerror =
                        function () {

                            reject(
                                new Error(
                                    "Could not load captured canvas image."
                                )
                            );

                        };


                    image.src = dataURL;


                } catch (error) {

                    reject(error);

                }

            }
        );

    }


    // ==========================================
    // RECORD GIF
    // ==========================================

    async function recordGIF() {

        console.log(
            "Starting GIF recording..."
        );


        let workerURL = null;


        // ==========================================
        // CREATE WORKER
        // ==========================================

        try {

            workerURL =
                await createWorkerURL();

        } catch (error) {

            console.error(error);


            alert(
                "Could not start the GIF encoder worker.\n\n" +
                "Make sure you are connected to the internet."
            );


            return;

        }


        // ==========================================
        // CREATE GIF
        // ==========================================

        const gif =
            new GIF({

                workers: 2,

                quality: 5,

                width: 345,

                height: 460,

                repeat: 0,

                transparent: 0x000000,

                workerScript:
                    workerURL

            });


        // ==========================================
        // PROGRESS
        // ==========================================

        gif.on(
            "progress",
            function (progress) {

                console.log(
                    "GIF rendering: " +
                    Math.round(
                        progress * 100
                    ) +
                    "%"
                );

            }
        );


        // ==========================================
        // FINISHED
        // ==========================================

        gif.on(
            "finished",
            function (blob) {

                console.log(
                    "GIF finished!"
                );


                const url =
                    URL.createObjectURL(
                        blob
                    );


                const link =
                    document.createElement(
                        "a"
                    );


                link.href = url;


                link.download =
                    "minecraft_skin_walking.gif";


                document.body.appendChild(
                    link
                );


                link.click();


                document.body.removeChild(
                    link
                );


                setTimeout(
                    function () {

                        URL.revokeObjectURL(
                            url
                        );


                        if (workerURL) {

                            URL.revokeObjectURL(
                                workerURL
                            );

                        }

                    },
                    5000
                );


                console.log(
                    "Downloaded minecraft_skin_walking.gif"
                );

            }
        );


        // ==========================================
        // ABORT
        // ==========================================

        gif.on(
            "abort",
            function () {

                console.error(
                    "GIF rendering aborted."
                );


                if (workerURL) {

                    URL.revokeObjectURL(
                        workerURL
                    );

                }

            }
        );


        // ==========================================
        // ERROR
        // ==========================================

        gif.on(
            "error",
            function (error) {

                console.error(
                    "GIF error:",
                    error
                );

            }
        );


        // ==========================================
        // RECORD FRAMES
        // ==========================================

        let frame = 0;


        async function captureFrame() {

            // ==========================================
            // FINISHED CAPTURING
            // ==========================================

            if (
                frame >= TOTAL_FRAMES
            ) {

                console.log(
                    "Finished recording!"
                );


                console.log(
                    "Captured frames:",
                    TOTAL_FRAMES
                );


                console.log(
                    "GIF duration:",
                    DURATION,
                    "seconds"
                );


                console.log(
                    "Frame delay:",
                    FRAME_DELAY,
                    "ms"
                );


                console.log(
                    "Rendering GIF..."
                );


                gif.render();


                return;

            }


            // ==========================================
            // CAPTURE CURRENT FRAME
            // ==========================================

            try {

                const frameImage =
                    await captureCanvasImage();


                // ==========================================
                // ADD FRAME
                // ==========================================

                gif.addFrame(
                    frameImage,
                    {
                        copy: true,

                        delay:
                            FRAME_DELAY
                    }
                );


                // ==========================================
                // INCREMENT FRAME
                // ==========================================

                frame++;


                console.log(
                    "Recording frame " +
                    frame +
                    " / " +
                    TOTAL_FRAMES
                );


                // ==========================================
                // WAIT FOR THE FRAME DELAY
                // ==========================================

                setTimeout(
                    captureFrame,
                    FRAME_DELAY
                );


            } catch (error) {

                console.error(
                    "Frame capture failed:",
                    error
                );

            }

        }


        // ==========================================
        // START RECORDING
        // ==========================================

        setTimeout(
            function () {

                captureFrame();

            },
            1500
        );

    }


    // ==========================================
    // LOAD SKIN
    // ==========================================

    async function start() {

        console.log(
            "Loading Minecraft skin..."
        );


        try {

            await viewer.loadSkin(
                skin
            );


            console.log(
                "Minecraft skin loaded."
            );


        } catch (error) {

            console.error(
                "Could not load Minecraft skin:",
                error
            );


            return;

        }


        // ==========================================
        // WAIT BEFORE RECORDING
        // ==========================================

        setTimeout(
            function () {

                recordGIF();

            },
            1000
        );

    }


    // ==========================================
    // START
    // ==========================================

    start();


})();

</script>

</body>

</html>
